# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/aussie_oct?schema=public

# --- Auth ------------------------------------------------------------------
# Required. Use a long, random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace_with_a_long_random_secret

# --- Server ----------------------------------------------------------------
PORT=5000

# --- CORS ------------------------------------------------------------------
# Comma-separated allow-list of frontend origins (never use "*").
CORS_ORIGINS=http://localhost:3000
